---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
const games = await getAllGames(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <section
      class="mb-8 rounded-2xl border border-slate-700 bg-slate-800/70 p-5 shadow-lg"
      aria-label="Game filters"
      data-testid="game-filters"
    >
      <div class="flex flex-col gap-5 lg:flex-row lg:items-end">
        <fieldset class="flex-1" data-testid="category-filters">
          <legend class="mb-3 text-sm font-medium uppercase tracking-wide text-slate-300">Categories</legend>
          <div class="flex flex-wrap gap-2">
            {categories.map((category) => (
              <label
                class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-slate-600 bg-slate-900/70 px-3 py-2 text-sm text-slate-200 transition hover:border-blue-500 hover:text-blue-200 focus-within:ring-2 focus-within:ring-blue-500 focus-within:outline-none"
              >
                <input
                  type="checkbox"
                  value={category.id}
                  class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-900"
                  data-testid={`category-filter-${category.id}`}
                  aria-label={`Filter games by ${category.name}`}
                />
                <span>{category.name}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="w-full lg:max-w-xs">
          <label for="publisher-filter" class="mb-2 block text-sm font-medium uppercase tracking-wide text-slate-300">
            Publisher
          </label>
          <select
            id="publisher-filter"
            data-testid="publisher-filter"
            aria-label="Filter games by publisher"
            class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 shadow-sm transition focus:ring-2 focus:ring-blue-500 focus:outline-none"
          >
            <option value="all">All publishers</option>
            {publishers.map((publisher) => (
              <option value={publisher.id}>{publisher.name}</option>
            ))}
          </select>
        </div>

        <button
          type="button"
          class="rounded-lg border border-slate-600 bg-slate-900 px-4 py-2 text-sm font-medium text-slate-200 transition hover:border-blue-500 hover:text-blue-200 focus:ring-2 focus:ring-blue-500 focus:outline-none"
          data-testid="clear-filters"
        >
          Clear filters
        </button>
      </div>
    </section>

    <div>
      <div class="mb-4 flex items-center justify-between gap-4">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>
        <p class="text-sm text-slate-300" data-testid="results-count">
          {games.length === 1 ? '1 game' : `${games.length} games`}
        </p>
      </div>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="grid hidden grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div class="hidden rounded-xl border border-slate-700 bg-slate-800/60 p-8 text-center text-slate-300" data-testid="filtered-empty-state">
            No games match the selected filters.
          </div>
        </>
      )}
    </div>
  </div>

  <script>
    const categoryInputs = Array.from(document.querySelectorAll<HTMLInputElement>('[data-testid^="category-filter-"]'));
    const publisherSelect = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
    const clearButton = document.querySelector<HTMLButtonElement>('[data-testid="clear-filters"]');
    const gameGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
    const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');
    const resultsCount = document.querySelector<HTMLElement>('[data-testid="results-count"]');
    const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));

    function applyFilters() {
      const selectedCategoryIds = new Set(
        categoryInputs
          .filter((input) => input.checked)
          .map((input) => input.value),
      );
      const selectedPublisherId = publisherSelect?.value ?? 'all';
      let visibleCount = 0;

      for (const card of gameCards) {
        const categoryId = card.dataset.gameCategoryId ?? '';
        const publisherId = card.dataset.gamePublisherId ?? '';
        const matchesCategory = selectedCategoryIds.size === 0 || selectedCategoryIds.has(categoryId);
        const matchesPublisher = selectedPublisherId === 'all' || selectedPublisherId === publisherId;
        const isVisible = matchesCategory && matchesPublisher;
        card.hidden = !isVisible;

        if (isVisible) {
          visibleCount += 1;
        }
      }

      if (gameGrid) {
        gameGrid.classList.toggle('hidden', visibleCount === 0);
      }

      if (emptyState) {
        emptyState.classList.toggle('hidden', visibleCount !== 0);
      }

      if (resultsCount) {
        resultsCount.textContent = `${visibleCount} game${visibleCount === 1 ? '' : 's'}`;
      }
    }

    for (const input of categoryInputs) {
      input.addEventListener('change', applyFilters);
    }

    if (publisherSelect) {
      publisherSelect.addEventListener('change', applyFilters);
    }

    if (clearButton) {
      clearButton.addEventListener('click', () => {
        for (const input of categoryInputs) {
          input.checked = false;
        }

        if (publisherSelect) {
          publisherSelect.value = 'all';
        }

        applyFilters();
      });
    }

    applyFilters();
  </script>
</Layout>
